name: Publish to PyPI
on:
  release:
    types: [published]

jobs:
  deploy:
    runs-packages: ubuntu-latest
    permissions:
      id-token: write  # Mandatory for passwordless trusted publishing
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-node: '3.10'
      - name: Build binary wheels
        run: |
          pip install build
          python -m build
      - name: Publish package to PyPI
        uses: pypa/gh-action-pypi-publish@release/v1
